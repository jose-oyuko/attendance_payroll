  "fixed_sql": [
    {
      "name": "companies",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"companies\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"version\" INTEGER NOT NULL DEFAULT 1, \"sync_state\" TEXT NOT NULL DEFAULT 'localOnly', \"deleted_at\" TEXT NULL, \"name\" TEXT NOT NULL, \"legal_name\" TEXT NULL, \"registration_number\" TEXT NULL, \"phone\" TEXT NULL, \"email\" TEXT NULL, \"address\" TEXT NULL, \"currency_code\" TEXT NOT NULL, \"timezone\" TEXT NOT NULL, \"logo_path\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "admin_users",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"admin_users\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"version\" INTEGER NOT NULL DEFAULT 1, \"sync_state\" TEXT NOT NULL DEFAULT 'localOnly', \"deleted_at\" TEXT NULL, \"company_id\" TEXT NOT NULL REFERENCES companies (id), \"username\" TEXT NOT NULL, \"display_name\" TEXT NOT NULL, \"role\" TEXT NOT NULL, \"active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"active\" IN (0, 1)), \"last_login_at\" TEXT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"company_id\", \"username\"));"
        }
      ]
    },
    {
      "name": "employees",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"employees\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"version\" INTEGER NOT NULL DEFAULT 1, \"sync_state\" TEXT NOT NULL DEFAULT 'localOnly', \"deleted_at\" TEXT NULL, \"company_id\" TEXT NOT NULL REFERENCES companies (id), \"employee_number\" TEXT NOT NULL, \"first_name\" TEXT NOT NULL, \"middle_name\" TEXT NULL, \"last_name\" TEXT NOT NULL, \"display_name\" TEXT NULL, \"phone\" TEXT NULL, \"email\" TEXT NULL, \"job_title\" TEXT NULL, \"employment_status\" TEXT NOT NULL, \"employment_start_date\" TEXT NOT NULL, \"employment_end_date\" TEXT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"company_id\", \"employee_number\"), CHECK (employment_end_date IS NULL OR employment_end_date >= employment_start_date));"
        }
      ]
    },
    {
      "name": "employee_rates",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"employee_rates\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"version\" INTEGER NOT NULL DEFAULT 1, \"sync_state\" TEXT NOT NULL DEFAULT 'localOnly', \"deleted_at\" TEXT NULL, \"employee_id\" TEXT NOT NULL REFERENCES employees (id), \"rate_type\" TEXT NOT NULL, \"amount_minor\" INTEGER NOT NULL, \"currency_code\" TEXT NOT NULL, \"effective_from\" TEXT NOT NULL, \"effective_to\" TEXT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"employee_id\", \"effective_from\"), CHECK (amount_minor > 0), CHECK (effective_to IS NULL OR effective_to >= effective_from));"
        }
      ]
    }
  ]
